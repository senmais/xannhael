// For format details, see https://containers.dev/implementors/json_reference/.
// For config options, see the README at:
// https://github.com/devcontainers/templates/tree/main/src/ruby
{
  "name": "${localWorkspaceFolderBasename}",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "workspaceFolder": "/workspaces/project",
  "initializeCommand": "docker volume create bundler-download-cache",

  // Use the standard non-root development user.
  "remoteUser": "vscode",

  // Keep the container user's UID/GID aligned where supported.
  "updateRemoteUserUID": true,

  // Features to add to the dev container. More info:
  // https://containers.dev/features
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/activestorage": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/rails/devcontainer/features/postgres-client": {}
  },

  "containerEnv": {
    "CAPYBARA_SERVER_PORT": "45678",
    "SELENIUM_HOST": "selenium",

    // NOTA: las credenciales de herramientas (OPENAI_API_KEY,
    // GITHUB_TOKEN/GH_TOKEN, KAMAL_REGISTRY_PASSWORD)
    // llegan via compose env_file desde el .env del proyecto.
    // No re-anadirlas aqui con ${localEnv:...}: una var de host ausente
    // expande a string vacio y pisa el valor de .env.

    // Git must trust the bind-mounted workspace before VS Code itself starts
    // inspecting the repository. setup-gh.sh runs too late for this initial check.
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "/workspaces/project",

    // Keep Git and GitHub CLI configuration inside the project-scoped volume.
    "GIT_CONFIG_GLOBAL": "/home/vscode/.local/share/.config/git/config",

    // GitHub CLI config and authentication state are project-scoped as well.
    "GH_CONFIG_DIR": "/home/vscode/.local/share/.config/gh",

    // Keep OpenCode config, sessions, service state and cache under one volume.
    "XDG_CONFIG_HOME": "/home/vscode/.local/share/.config",
    "XDG_DATA_HOME": "/home/vscode/.local/share",
    "XDG_STATE_HOME": "/home/vscode/.local/share/.state",
    "XDG_CACHE_HOME": "/home/vscode/.local/share/.cache",

    // Bundler installation path.
    "BUNDLE_PATH": "/usr/local/bundle",
    // Share downloaded gem archives; installed gems stay project-scoped.
    "BUNDLE_USER_CACHE": "/home/vscode/.bundle/cache",
    "BUNDLE_GLOBAL_GEM_CACHE": "true",

    // Parallel gem installation when dependencies actually change.
    "BUNDLE_JOBS": "8",
    "BUNDLE_RETRY": "3"

  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [3000],

  // Configure forwarded-port behaviour.
  "portsAttributes": {
    "3000": {
      "label": "Xannhael Rails",
      "onAutoForward": "notify"
    }
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "rubyLsp.rubyVersionManager": {
          "identifier": "none"
        },
        "rubyLsp.formatter": "rubocop_internal",
        "editor.inlineSuggest.enabled": true,
        "github.copilot.enable": {
          "*": true
        },
        "git.autofetch": true,
        "git.confirmSync": false,
        "githubPullRequests.pullBranch": "never",
        "files.watcherExclude": {
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true,
          "**/tmp/cache/**": true,
          "**/log/**": true,
          "**/storage/**": true,
          "**/vendor/bundle/**": true,
          "**/node_modules/**": true
        },
        "search.exclude": {
          "**/tmp/**": true,
          "**/log/**": true,
          "**/storage/**": true,
          "**/vendor/bundle/**": true,
          "**/node_modules/**": true
        }
      },
      "extensions": [
        "Shopify.ruby-lsp",
        "koichisasada.vscode-rdbg",
        "jemmyw.rails-fast-nav",
        "aliariff.vscode-erb-beautify",
        "marcoroth.herb-lsp",
        "marcoroth.stimulus-lsp",
        "bradlc.vscode-tailwindcss",
        "github.copilot",
        "github.copilot-chat",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "GitHub.remotehub",
        "github.vscode-github-actions",
        "openai.chatgpt"
      ]
    }
  },

  // Initialize volume ownership once, then install gems only when needed.
  // Optional credentials and database changes stay out of container creation.
  "postCreateCommand": "bash .devcontainer/init-volumes.sh && (bundle check || bundle install)"
}
