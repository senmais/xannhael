<div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start py-10 sm:py-14">
  <div class="space-y-6">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-foreground"><%= t("home.kamal.title") %></h2>
    <p class="text-base text-muted leading-relaxed"><%= t("home.kamal.intro") %></p>
    <ol class="space-y-6">
      <% (1..3).each do |i| %>
        <li class="flex gap-4">
          <%= tag.span format("%02d", i),
              class: "shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-lg bg-primary text-primary-foreground text-sm font-bold" %>
          <div>
            <h3 class="font-bold text-foreground"><%= t("home.kamal.step#{i}_title") %></h3>
            <p class="mt-1 text-sm text-muted leading-relaxed"><%= t("home.kamal.step#{i}_text") %></p>
          </div>
        </li>
      <% end %>
    </ol>
  </div>

  <div>
    <div class="rounded-xl border border-border bg-neutral-900 text-neutral-100 shadow-lg overflow-hidden">
      <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10">
        <span class="w-3 h-3 rounded-full bg-red-500"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
        <span class="w-3 h-3 rounded-full bg-green-500"></span>
        <span class="ml-2 text-xs text-neutral-400 font-mono"><%= t("home.kamal.terminal_title") %></span>
      </div>
      <div class="p-4 text-sm font-mono leading-relaxed space-y-1">
        <p><span class="text-green-400">$</span> kamal setup</p>
        <p class="text-neutral-400">Provisioning server with Docker, proxy, and TLS...</p>
        <p><span class="text-green-400">$</span> kamal deploy</p>
        <p class="text-neutral-400">Build (20.4s) → Push (3.1s) → Deploy</p>
        <p><span class="text-green-400">$</span> kamal rollback</p>
        <p class="text-neutral-400">Restored previous release in 2.0s</p>
      </div>
    </div>
  </div>
</div>