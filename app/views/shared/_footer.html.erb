<footer class="relative bg-footer-bg text-foreground mt-auto">
  <div class="py-6 sm:py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-0">
        <p class="text-sm text-muted">&copy; <%= Time.current.year %> <%= t("footer.copyright") %></p>
        <div class="flex items-center gap-4">
          <%= link_to t("footer.privacy"), "#", class: "text-sm text-link hover:text-link/80" %>
          <%= link_to t("footer.terms"), "#", class: "text-sm text-link hover:text-link/80" %>
        </div>
      </div>
    </div>
  </div>
</footer>