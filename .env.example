# =============================================================================
# XANNHAEL - Environment Variables
# =============================================================================
# Single source of truth for local environment.
#
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the empty values (API keys, tokens, passwords).
#   3. Rebuild the devcontainer.
#
# The .env file is gitignored and will NOT be committed. This .example file
# IS committed and documents every variable. Pre-filled values are working
# development defaults (shared postgres-db on the host); empty values must
# be provided by you.
#
# Loading order: docker compose reads .env into the devcontainer
# (see .devcontainer/compose.yaml `env_file`). Do NOT duplicate these keys
# in devcontainer.json `containerEnv` — that would silently shadow .env.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Activates the credentials-based PostgreSQL connection (host, port, username,
# password) from config/credentials.yml.enc. Required for the devcontainer.
DB_HOST=host.docker.internal

# PostgreSQL client variables (for psql inside the devcontainer).
# They target the shared postgres-db container (see README quick start).
PGHOST=host.docker.internal
PGPORT=55432
PGUSER=postgres
PGPASSWORD=postgres

# -----------------------------------------------------------------------------
# RAILS
# -----------------------------------------------------------------------------
# Master key to decrypt config/credentials.yml.enc.
# OPTIONAL: Rails reads config/master.key automatically when this is not set.
# Only needed in production/CI where the master.key file does not exist.
# To get the value: cat config/master.key
# RAILS_MASTER_KEY=

# Rails environment (development, test, production).
# RAILS_ENV=development

# Threads per Puma worker / Active Record connection pool.
# RAILS_MAX_THREADS=5

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
# Port for the Puma web server.
# PORT=3000

# Number of Puma workers (set to 2+ for multi-process).
# WEB_CONCURRENCY=1

# Run the Solid Queue supervisor inside Puma (single-server deployments).
# SOLID_QUEUE_IN_PUMA=1

# Number of Solid Queue worker processes.
# JOB_CONCURRENCY=1

# -----------------------------------------------------------------------------
# DEBUGGING
# -----------------------------------------------------------------------------
# Allow remote debugger connections.
RUBY_DEBUG_OPEN=true

# Lazy-load the debugger gem.
RUBY_DEBUG_LAZY=true

# -----------------------------------------------------------------------------
# TESTING
# -----------------------------------------------------------------------------
# Capybara server port for system tests (devcontainer).
CAPYBARA_SERVER_PORT=45678

# Selenium host for system tests (devcontainer).
# The selenium service in .devcontainer/compose.yaml is commented out by
# default; start it on demand (see the comments there).
SELENIUM_HOST=selenium

# -----------------------------------------------------------------------------
# DEPLOYMENT (Kamal)
# -----------------------------------------------------------------------------
# Docker registry authentication password.
# KAMAL_REGISTRY_PASSWORD=

# -----------------------------------------------------------------------------
# CI / PRODUCTION
# -----------------------------------------------------------------------------
# Full PostgreSQL connection URL (CI only).
# DATABASE_URL=postgres://postgres:postgres@localhost:5432

# PostgreSQL password for the production user 'xannhael'.
# XANNHAEL_DATABASE_PASSWORD=

# -----------------------------------------------------------------------------
# AI / CLI TOOLS
# -----------------------------------------------------------------------------
# OpenAI API key (Codex CLI + IDE extension).
# OPENAI_API_KEY=

# OpenCode API key.
# OPENCODE_API_KEY=

# GitHub Personal Access Token for the `gh` CLI inside the container
# (avoids `gh auth login`). Classic or fine-grained PAT with scopes:
# repo, read:org, read:project.
# GITHUB_TOKEN=
# GH_TOKEN=
